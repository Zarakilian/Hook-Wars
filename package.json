{
  "name": "hook-wars",
  "version": "0.1.0",
  "private": true,
  "description": "Hook Wars: a voxel hook-brawler for the browser. Up to 5v5 over a river, bots fill empty slots.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@noble/hashes": "1.8.0",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/app": "1.1.1",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
