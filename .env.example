# Hook Wars server settings. Copy to .env (gitignored); `npm start` reads it if it exists.
# Standard edition: Pearls only. No keys, wallets or payment settings belong in this file.

# on | off. off = no accounts, everyone wears the default cosmetic sets.
ECONOMY=on
# Folder for economy.db (accounts, items, listings) and its start-up backup economy.db.bak.
# Keep it on a local disk (not a network drive or a synced folder) and out of git.
# One server per folder: a second server on the same folder runs without an economy.
ECONOMY_DATA_DIR=./data
