# Hook Wars economy settings. Copy to .env (gitignored); `npm start` reads it if it exists.
# Standard edition: Pearls only. No keys, wallets or payment settings belong in this file.
# The other server settings (HOST, PORT, TRUST_PROXY, STATIC_DIR, ...) are listed in server/config.ts.

# on | off. off = no accounts, everyone wears the default cosmetic sets.
ECONOMY=on
# The Steam desktop build connects from the origin app://hookwars. A dedicated server that Steam players
# reach from the Online screen must allow it, or it answers 403:
# ALLOWED_ORIGINS=app://hookwars
# (ECONOMY=trust and RELAY_SECRET are set by the desktop app for player-hosted lobbies; never set them here.)
# Folder for economy.db (accounts, items, listings) and its start-up backup economy.db.bak.
# Keep it on a local disk (not a network drive or a synced folder) and out of git.
# One server per folder: a second server on the same folder runs without an economy.
ECONOMY_DATA_DIR=./data
