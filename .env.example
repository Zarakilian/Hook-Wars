# Hook Wars economy settings. Copy to .env (gitignored) and start with: node --env-file=.env server/index.ts
# Placeholders only. Never put a private key in this file: ECONOMY_KEYPAIR_PATH points at a key file outside the repo.

# on | off. off = no accounts, everyone wears the default cosmetic sets.
ECONOMY=on
# Folder for economy.json (accounts, items, listings, orders). Keep it out of git.
ECONOMY_DATA_DIR=./data
# Name shown in the wallet sign-in message; normally your public host name.
ECONOMY_DOMAIN=hookwars.example
# off | devnet. devnet sells Limited items for devnet USDC. mainnet is refused until the legal checklist in docs/economy.md is done.
ECONOMY_NETWORK=off
# Devnet RPC endpoint. The server refuses anything whose genesis hash is not devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Fee payer and mint authority keypair (64-number JSON), stored OUTSIDE this project folder.
ECONOMY_KEYPAIR_PATH=C:/Users/<you>/.hookwars/devnet-fee-payer.json
# Wallet address that receives USDC. Address only, its key never goes on the server.
TREASURY_ADDRESS=<treasury-wallet-address>
# Devnet USDC mint address (see docs/economy.md, "Devnet setup", step 3).
USDC_MINT=<devnet-usdc-mint-address>
# Metaplex Core collection for Limited items, printed by server/economy/setupDevnet.ts.
CORE_COLLECTION=<core-collection-address>
# Optional base URL for NFT metadata JSON (<base>/<item id>.json). Leave empty for now.
NFT_METADATA_BASE_URL=
